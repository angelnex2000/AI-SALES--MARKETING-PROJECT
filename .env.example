# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sales
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_sales

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (for Research Agent, Outreach Agent)
OPENAI_API_KEY=sk-...

# Email (for outreach sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password

# Background jobs (Celery worker — Module 9)
REDIS_URL=redis://localhost:6379/0

# CRM credential encryption at rest (Module 8) — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-this-to-a-generated-fernet-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
