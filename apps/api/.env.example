# Copy to `.env` and fill in. Never commit the real `.env`.
#
# Two consumers read env vars, and they read different files:
#   - Running the API directly (`uvicorn app.main:app` from apps/api/) loads
#     apps/api/.env, because core/config.py sets `env_file = ".env"` relative
#     to the working directory.
#   - `docker-compose up` from the repo root loads the ROOT .env, and injects
#     DATABASE_URL / REDIS_URL itself pointing at the `db` and `redis`
#     services. Root .env only needs the POSTGRES_* block at the bottom plus
#     whichever secrets below you want passed through.

# --- Application identity -----------------------------------------------

APP_NAME="AI Marketing & Sales Teammate"

# development | staging | production. Production turns off /docs, /redoc and
# /openapi.json, switches logs to JSON, and enables the startup readiness
# warnings in core/config.py::check_production_readiness.
ENVIRONMENT=development

# Mount point for every router. A future v2 gets a second prefix alongside
# this one — never edit this to /api/v2.
API_V1_PREFIX=/api/v1

# --- Required: the app will not start without these ---------------------

# Async driver is mandatory — core/database.py uses create_async_engine.
# A plain `postgresql://` URL will fail at startup.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_sales

# Signs the JWT that becomes the httpOnly access_token cookie. Any long
# random string; rotating it invalidates every logged-in session.
SECRET_KEY=change-me-to-a-long-random-string

# --- Connection pool ----------------------------------------------------
# Per process. The API and each Celery worker are separate processes, so
# total Postgres connections ~= (POOL_SIZE + MAX_OVERFLOW) x processes.

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Logs every SQL statement. Local debugging only — query text contains lead
# PII and would be shipped to the log aggregator.
DB_ECHO=false

# --- Auth ---------------------------------------------------------------

ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Background jobs ----------------------------------------------------

# Celery broker + result backend. The AI orchestrator dispatches every slow
# agent call here (202 + job_id), so this is not optional in dev.
REDIS_URL=redis://localhost:6379/0

# --- Integrations at rest -----------------------------------------------

# Fernet key encrypting Integration OAuth tokens via core/security.py.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before creating any Integration that carries credentials.
ENCRYPTION_KEY=

# --- Observability ------------------------------------------------------

LOG_LEVEL=INFO

# json | console | auto. "auto" = console in development, json everywhere
# else. Logs go to stdout only — there is no system_logs table by design.
LOG_FORMAT=auto

# --- CORS ---------------------------------------------------------------

# Comma-separated origins allowed to send the httpOnly auth cookie. Must
# list real origins in production; "*" is incompatible with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Optional: unset means the dependent feature is inert ---------------

# Which provider writes outreach drafts: auto | anthropic | openai.
# "auto" takes whichever key is present (Anthropic first), which is right for
# a workspace that only ever set one. Naming a provider explicitly makes an
# unconfigured one fail loudly rather than silently falling through to the
# other vendor and billing the wrong account.
LLM_PROVIDER=auto

# Embeddings (RAG) are OpenAI-only — Anthropic has no embeddings API — so this
# key is required for knowledge-base grounding regardless of LLM_PROVIDER.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude for the Personalized Outreach Agent. Note temperature is NOT sent to
# this model (it returns a 400); run-to-run variance is held down with
# output_config.effort instead — see agents/outreach/providers.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Outbound email for the Outreach Center (post Gate 2 approval).
# Email delivery. Mailjet's SMTP relay takes the API key as the username and
# the secret key as the password, so no provider SDK is needed.
# Live web sourcing for the Research Agent (search + fetch).
# Empty means the agent reasons over lead data and CRM notes only — a thinner
# report, not a broken one, with a correspondingly lower coverage confidence.
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_TIMEOUT_SECONDS=20

SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=          # Mailjet API key
SMTP_PASSWORD=      # Mailjet secret key

# Real mail only leaves the building when this is true. Credentials being
# present is NOT consent to email prospects: with this false, send_draft still
# runs the whole Gate 2 state machine and writes SentEmail + the timeline
# entry, recording delivery_status="dry_run" instead of transmitting.
EMAIL_SEND_ENABLED=false
# Must be a sender Mailjet has validated, or the relay rejects the message.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_TIMEOUT_SECONDS=15

# --- docker-compose only (repo-root .env) -------------------------------
# Consumed by docker-compose.yml to provision the db container, not by
# app/core/config.py. They have compose-level defaults, so a root .env can
# omit them entirely.

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ai_sales